# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts keep LF on every checkout: sh under WSL and bash under Git for
# Windows both stop at a CR-LF line ending, which a Windows checkout with
# core.autocrlf would otherwise give them.
*.sh text eol=lf

# Binaries carried for the NPU and Wi-Fi stacks, and the boot loader's
# image: never touch their bytes.
*.a binary
*.bin binary
*.raw binary
*.se binary
